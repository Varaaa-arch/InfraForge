APP_NAME=InfraForge
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key
# Kunci enkripsi untuk nilai sensitif (env var project, channel alert).
# WAJIB di production. Jika dirotasi, ciphertext lama tidak bisa didekripsi.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-this-to-a-random-encryption-key

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=infraforge
POSTGRES_USER=infraforge
POSTGRES_PASSWORD=infraforge

REDIS_HOST=localhost
REDIS_PORT=6379
# Prometheus & metrics (server/container performance)
# Di Docker Compose gunakan http://prometheus:9090; dari host gunakan http://localhost:9090.
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=10

# Alerting (Prometheus + Alertmanager)
ALERT_WEBHOOK_SECRET=dev-alert-token
ALERT_REQUEST_TIMEOUT=10

# Container image vulnerability scanning (Trivy)
# Image backend Docker sudah memasang Trivy. Untuk dev lokal, pasang binary
# trivy di PATH atau arahkan TRIVY_PATH ke lokasi binary.
TRIVY_PATH=trivy
# TRIVY_CACHE_DIR=/var/lib/trivy
IMAGE_SCAN_TIMEOUT_SECONDS=180
IMAGE_SCAN_MAX_OUTPUT_BYTES=10485760
IMAGE_SCAN_MAX_FINDINGS=500
# Alert dikirim bila jumlah CRITICAL/HIGH MELEBIHI threshold ini.
IMAGE_SCAN_CRITICAL_THRESHOLD=0
IMAGE_SCAN_HIGH_THRESHOLD=0
IMAGE_SCAN_NOTIFICATIONS_ENABLED=true

# TLS/SSL domain certificate monitoring
TLS_DOMAIN_CHECK_TIMEOUT_SECONDS=10
TLS_DOMAIN_CACHE_TTL_SECONDS=300
TLS_DOMAIN_EXPIRY_WARNING_DAYS=30
TLS_DOMAIN_MAX_TARGETS=50
# Jangan aktifkan di production kecuali target memang internal (risiko SSRF).
TLS_DOMAIN_ALLOW_PRIVATE_IP=false
TLS_NOTIFICATIONS_ENABLED=true
TLS_ALERT_COOLDOWN_SECONDS=86400
