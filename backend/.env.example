APP_NAME=InfraForge
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key
# Kunci enkripsi untuk nilai sensitif (env var project, channel alert).
# WAJIB di production. Jika dirotasi, ciphertext lama tidak bisa didekripsi.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-this-to-a-random-encryption-key

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=infraforge
POSTGRES_USER=infraforge
POSTGRES_PASSWORD=infraforge

REDIS_HOST=localhost
REDIS_PORT=6379
# Prometheus & metrics (server/container performance)
# Di Docker Compose gunakan http://prometheus:9090; dari host gunakan http://localhost:9090.
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=10

# Alerting (Prometheus + Alertmanager)
ALERT_WEBHOOK_SECRET=dev-alert-token
ALERT_REQUEST_TIMEOUT=10
